{"content":"class TestFactorial:\n    def test_factorial_0(self):\n        self.assertEqual(factorial(0), 1)\n\n    def test_factorial_1(self):\n        self.assertEqual(factorial(1), 1)\n\n    def test_factorial_positives(self):\n        self.assertEqual(factorial(2), 2)\n        self.assertEqual(factorial(3), 6)\n        self.assertEqual(factorial(4), 24)\n\n    def test_factorial_negatives(self):\n        with self.assertRaises RecursionError:\n            factorial(-1)\n\n    def test_factorial_non_int(self):\n        with self.assertRaises TypeError:\n            factorial('a')\n\nclass TestFibonacci:\n    def test_fibonacci_0(self):\n        self.assertEqual(fibonacci(0), 0)\n\n    def test_fibonacci_1(self):\n        self.assertEqual(fibonacci(1), 1)\n\n    def test_fibonacci_positives(self):\n        self.assertEqual(fibonacci(2), 1)\n        self.assertEqual(fibonacci(3), 2)\n        self.assertEqual(fibonacci(4), 3)\n\n    def test_fibonacci_negatives(self):\n        self.assertEqual(fibonacci(-1), 0)\n\n    def test_fibonacci_non_int(self):\n        with self.assertRaises TypeError:\n            fibonacci('a')\n\nclass TestPalindrome:\n    def test_palindrome_empty_string(self):\n        self.assertTrue(palindrome(''))\n\n    def test_palindrome_single_char(self):\n        self.assertTrue(palindrome('a'))\n\n    def test_palindrome_even_length(self):\n        self.assertTrue(palindrome('madam'))\n\n    def test_palindrome_odd_length(self):\n        self.assertTrue(palindrome('radar'))\n\n    def test_palindrome_non_palindrome(self):\n        self.assertFalse(palindrome('python'))\n\n    def test_palindrome_non_str(self):\n        with self.assertRaises AttributeError:\n            palindrome(123)\n\nclass TestIsPrime:\n    def test_is_prime_2(self):\n        self.assertTrue(is_prime(2))\n\n    def test_is_prime_3(self):\n        self.assertTrue(is_prime(3))\n\n    def test_is_prime_positives(self):\n        self.assertTrue(is_prime(17))\n        self.assertTrue(is_prime(23))\n\n    def test_is_prime_negatives(self):\n        self.assertFalse(is_prime(-1))\n\n    def test_is_prime_zero(self):\n        self.assertFalse(is_prime(0))\n\n    def test_is_prime_one(self):\n        self.assertFalse(is_prime(1))\n\n    def test_is_prime_two(self):\n        self.assertFalse(is_prime(2))\n\n    def test_is_prime_non_int(self):\n        with self.assertRaises TypeError:\n            is_prime('a')\n\nimport unittest\nfrom unittest.mock import patch\n\nclass TestMain:\n    def test_main_prime_palindrome(self):\n        with patch('builtins.input', return_value='2'):\n            self.assertEqual(main(), '2 is a prime palindrome.\nIt corresponds to 2 factorial and 1 fibonacci value which is 1\n')\n\n    def test_main_non_prime_palindrome(self):\n        with patch('builtins.input', return_value='4'):\n            self.assertEqual(main(), '4 cannot process the number as it is not a prime palindrome.')\n\nif __name__ == '__main__':\n    unittest.main()"}